# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:4200

# Database
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (uncomment when ready):
# DATABASE_URL=postgresql://user:password@localhost:5432/weather_db

# CORS (Frontend URL for development)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# API Configuration
API_BASE_URL=http://localhost:8000/api

# OpenWeatherMap (create an account at https://openweathermap.org/)
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_CACHE_TTL=600

# Email Configuration (for alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
